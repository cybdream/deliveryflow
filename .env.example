# Copy to .env. Do not commit your actual values.
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
# Base64-encoded random value of at least 32 bytes.
APP_JWT_SECRET=CHANGE_THIS_BASE64_SECRET

# Local Docker bootstrap accounts. Created once when their email does not exist.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@deliveryflow.local
APP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
APP_BOOTSTRAP_DRIVER_EMAIL=driver@deliveryflow.local
APP_BOOTSTRAP_DRIVER_PASSWORD=CHANGE_THIS_DRIVER_PASSWORD
